# SCC Platform — staging/runtime Replit config (do not publish without approval).
# Single Uvicorn process serves FastAPI + Vite FRONTEND_DIST. No Vite dev server.

run = "bash scripts/replit_start.sh"
modules = ["nodejs-20", "python-3.12", "postgresql-16"]

[nix]
channel = "stable-24_05"

[deployment]
build = ["bash", "scripts/replit_build.sh"]
run = ["bash", "scripts/replit_run.sh"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 8000
externalPort = 80

[objectStorage]
defaultBucketID = "replit-objstore-40d6bb8b-99db-496f-b4ef-ffcfbe16b09f"
