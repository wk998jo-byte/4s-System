# SCC Platform API — local prototype
# Copy to .env in this folder if you need to override defaults.

APP_NAME=SCC Platform API
APP_ENV=development
APP_VERSION=0.1.0-prototype

# Bind address used in README only; uvicorn is started from the CLI.
HOST=127.0.0.1
PORT=8000

# Comma-separated browser origins allowed to call this API.
# Do not set CORS_ORIGINS=* in production.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# sqlite (default file backend/data/scc_platform.db) or postgresql
STORAGE_BACKEND=sqlite
# Leave empty to use the local SQLite file.
# With Docker: docker compose up -d
# Then set:
# STORAGE_BACKEND=postgresql
# DATABASE_URL=postgresql+psycopg://scc:scc@127.0.0.1:5432/scc_platform
DATABASE_URL=

# Optional: live email when Admin issues a monthly report (PDF/HTML + Excel/CSV).
# Leave SMTP_HOST empty to save a copy under backend/data/outbox/ instead.
#
# Gmail / Google Workspace (recommended for rose.subait@… on Gmail):
# 1) Google Account → Security → 2-Step Verification (must be on)
# 2) Security → App passwords → create one for "Mail"
# 3) Paste the 16-character app password below (spaces optional)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_TLS=true
# SMTP_USER=you@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx
# SMTP_FROM=you@gmail.com
